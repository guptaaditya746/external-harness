@prefix hrn: <https://harness.local/schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

hrn:Paper a owl:Class ; rdfs:label "Paper" ; rdfs:comment "A publication in the corpus." .
hrn:Dataset a owl:Class ; rdfs:subClassOf hrn:ResearchEntity ; rdfs:comment "A dataset or benchmark." .
hrn:ResearchEntity a owl:Class .
hrn:researchRelation a owl:ObjectProperty .
hrn:usesDataset a owl:ObjectProperty ; rdfs:subPropertyOf hrn:researchRelation ; rdfs:domain hrn:Paper ;
    rdfs:range hrn:Dataset ; rdfs:comment "The paper evaluates on or trains with the dataset." .
hrn:authoredBy a owl:ObjectProperty ; rdfs:domain hrn:Paper ; rdfs:comment "An author of the paper." .
